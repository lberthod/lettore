build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Build output
dist/
generator/test-output/

# Secrets de leggendo-server (jamais commités, seul .example l'est)
leggendo-server/leggendo-api.env
leggendo-server/*.json.key
leggendo-server/service-account*.json

# Notes VPS locales (jamais commitées)
VPS.md

# Identifiants FTP de déploiement (jamais commités, seul .example l'est)
scripts/.env.deploy

# Données intermédiaires/scratch de génération (reproductibles via les
# scripts, pas la source de vérité — voir src/dictionary/ pour le résultat)
scripts/data/

# macOS
.DS_Store

# Android (Capacitor) — build local, jamais commité
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/app/release/
*.aab
*.apk

# Secrets Android : jamais commités (clé de signature, config Firebase native)
android/keystore/
android/app/google-services.json
android/keystore.properties

# iOS (Capacitor) — dépendances et artefacts de build, régénérés par
# `pod install` / Xcode / `npm run build:ios`. Le projet Xcode (ios/App)
# reste versionné, pas ces sous-dossiers.
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App/public/
ios/.build/
*.xcuserstate
xcuserdata/

# Secrets iOS : jamais commités (config Firebase native)
ios/App/App/GoogleService-Info.plist

# Icône/splash source générés à la volée (voir apk doc.md / apkdoc.md) — pas
# la source de vérité, régénérables depuis public/favicon.svg.
resources/
