# Copier ce fichier en /opt/leggendo-api/leggendo-api.env sur le VPS
# (hors du repo, permissions 600, jamais commité — voir README.md).

PORT=8091
GLM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/opt/leggendo-api/service-account.json
ALLOWED_ORIGINS=https://leggendo.fr,https://leggendo-dbb84.web.app,https://leggendo-dbb84.firebaseapp.com

# Optionnel — défauts déjà corrects en général :
# GLM_MODEL=deepseek-v4-flash
# GLM_BASE_URL=
# GLM_FALLBACK_URL=
# GLM_TIMEOUT_MS=480000
