rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Textes : lecture publique des textes publiés gratuits ;
    // les textes premium exigent le custom claim `premium`
    // (posé par le webhook Stripe via l'Admin SDK).
    match /texts/{textId} {
      allow read: if resource.data.status == 'published'
        && (resource.data.premium != true
            || (request.auth != null && request.auth.token.premium == true));
      allow write: if false; // écriture uniquement via l'Admin SDK (scripts)
    }

    // Index léger des textes publiés (titres, niveaux, extraits) : public.
    match /meta/index {
      allow read: if true;
      allow write: if false;
    }

    // Profil utilisateur : liste des textes créés (« Créer son texte »).
    // Chacun ne lit et n'écrit que son propre document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Textes générés à la demande par les utilisateurs : privés, liés à leur
    // auteur via le champ `owner`. Immuables une fois créés (pas d'update).
    match /userTexts/{textId} {
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.owner == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
