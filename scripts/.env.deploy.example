# Copie ce fichier en scripts/.env.deploy et renseigne les vraies valeurs.
# scripts/.env.deploy n'est jamais commité (voir .gitignore).

FTP_HOST=mncc.ftp.infomaniak.com
FTP_USER=mncc_leggendo
FTP_PASSWORD=
# Dossier distant où déployer (racine du site sur l'hébergement Infomaniak)
FTP_REMOTE_DIR=/
FTP_SECURE=true
